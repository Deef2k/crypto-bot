# 1. Базовый образ Go
FROM golang:1.26.4-alpine

# 2. Рабочая папка внутри контейнера
WORKDIR /app

# 3. Копируем файлы зависимостей (лучшая практика для кэширования)
COPY go.mod go.sum ./

# 4. Скачиваем библиотеки (pgx, godotenv)
RUN go mod download

# 5. Копируем ВЕСЬ остальной код проекта (включая main.go и папку internal!)
COPY . .

# 6. Собираем исполняемый файл
RUN go build -o app .

# 7. Запускаем приложение
CMD ["./app"]